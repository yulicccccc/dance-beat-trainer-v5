{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dance-beat-trainer-v5",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
